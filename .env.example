# Copia questo file in .env.local (sviluppo) e imposta le stesse variabili su Vercel (produzione).
# Ogni servizio è facoltativo: se mancano le sue variabili, l'oggetto nello studio resta "spento".

# ── URL pubblico del sito ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://raffaelevitale.it

# ── Spotify: giradischi e vinili ────────────────────────────────────
# 1. Crea un'app su https://developer.spotify.com/dashboard
# 2. Aggiungi come Redirect URI: http://127.0.0.1:8888/callback
# 3. Metti qui ID e secret, poi lancia: node --env-file=.env.local scripts/spotify-token.mjs
# 4. Incolla qui il refresh token che stampa il terminale
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── GitHub: monitor della scrivania ─────────────────────────────────
# Senza token funzionano repository e commit; il grafico dei contributi richiede un token.
# Crea un "fine-grained token" senza permessi aggiuntivi: https://github.com/settings/personal-access-tokens
GITHUB_USERNAME=raffaelevitale
GITHUB_TOKEN=

# ── Steam: il televisore ────────────────────────────────────────────
# Chiave: https://steamcommunity.com/dev/apikey
# STEAM_ID è lo SteamID64 (17 cifre). Profilo e dettagli di gioco devono essere pubblici.
STEAM_API_KEY=
STEAM_ID=

# ── Letterboxd: le locandine ────────────────────────────────────────
# Basta il nome utente: si legge il feed RSS pubblico.
LETTERBOXD_USERNAME=
